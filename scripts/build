#!/bin/bash
set -e

source $(dirname $0)/version
cd $(dirname $0)/..

KERNEL_DIR=build/kernel

# some hacking
mkdir -p ${KERNEL_DIR}/debian/stamps
chmod a+x ${KERNEL_DIR}/debian*/scripts/*
chmod a+x ${KERNEL_DIR}/debian*/scripts/misc/*

# Annotations may list vendor/ODM CONFIG options (e.g. UBUNTU_ODM_DRIVERS, AAEON_*)
# that aren't reachable in our generic .config. There's no make switch to skip
# this check, so neutralize the checkers — same spirit as skipabi/skipmodule.
# - debian/scripts/config-check (perl) is purely a checker → stub it outright.
# - debian/scripts/misc/annotations (python) is also used to *generate* the
#   .config during prepare-tree, so we wrap it: --check returns 0, anything
#   else defers to the real script.
printf '#!/usr/bin/perl\nexit 0;\n' > ${KERNEL_DIR}/debian/scripts/config-check
chmod a+x ${KERNEL_DIR}/debian/scripts/config-check

ANN=${KERNEL_DIR}/debian/scripts/misc/annotations
if [ -f "${ANN}" ] && ! [ -f "${ANN}.real" ]; then
    mv "${ANN}" "${ANN}.real"
    cat > "${ANN}" <<'EOF'
#!/usr/bin/env python3
import os, sys
if '--check' in sys.argv:
    sys.exit(0)
real = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'annotations.real')
os.execv(real, [real] + sys.argv[1:])
EOF
    chmod a+x "${ANN}"
fi

# kernel
pushd ${KERNEL_DIR}
SAVE_ARCH="${ARCH}"
unset -v ARCH KERNEL_DIR

DEBIAN_RULES_FLAGS=(
    do_zfs=false
    do_dkms_nvidia=false
    do_dkms_nvidia_server=false
    skipabi=true
    skipmodule=true
    skipretpoline=true
    do_enforce_all=false
)

debian/rules clean

# Materialize .config from annotations *without* starting the binary build,
# so we can apply CVE-mitigation config overrides for kernel subsystems that
# have no upstream fix in this iteration:
#   CONFIG_CRYPTO_USER_API_AEAD — CVE-2026-31431 (Copy Fail, algif_aead)
#   CONFIG_INET_ESP            — CVE-2026-43284 (Dirty Frag, esp4)
#   CONFIG_INET6_ESP           — CVE-2026-43284 (Dirty Frag, esp6)
#   CONFIG_AF_RXRPC            — CVE-2026-43500 (Dirty Frag, rxrpc)
debian/rules debian/stamps/stamp-prepare-tree-generic "${DEBIAN_RULES_FLAGS[@]}"

BUILD_CONFIG=debian/build/build-generic/.config
if [ -f "${BUILD_CONFIG}" ]; then
    ./scripts/config --file "${BUILD_CONFIG}" \
        --disable CRYPTO_USER_API_AEAD \
        --disable INET_ESP \
        --disable INET6_ESP \
        --disable AF_RXRPC

    # Resolve dependencies in the modified .config. olddefconfig needs ARCH
    # set to the *kernel* arch (not the dapper/host arch label).
    case "${SAVE_ARCH}" in
        amd64) export ARCH=x86 ;;
        arm64) export ARCH=arm64 ;;
        arm)   export ARCH=arm ;;
    esac
    yes '' | make O=debian/build/build-generic olddefconfig
    unset -v ARCH

    # Keep the stamp newer than .config so binary-generic doesn't redo prepare.
    touch debian/stamps/stamp-prepare-tree-generic
fi

# see https://wiki.ubuntu.com/KernelTeam/KernelMaintenance#Overriding_module_check_failures
debian/rules binary-headers binary-generic "${DEBIAN_RULES_FLAGS[@]}"
popd
