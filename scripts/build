#!/bin/bash
set -e

source $(dirname $0)/version
cd $(dirname $0)/..

KERNEL_DIR=build/kernel

# some hacking
mkdir -p ${KERNEL_DIR}/debian/stamps
chmod a+x ${KERNEL_DIR}/debian*/scripts/*
chmod a+x ${KERNEL_DIR}/debian*/scripts/misc/*

# Annotations may list vendor/ODM CONFIG options (e.g. UBUNTU_ODM_DRIVERS, AAEON_*)
# that aren't reachable in our generic .config. There's no make switch to skip
# this check, so neutralize the checkers — same spirit as skipabi/skipmodule.
# - debian/scripts/config-check (perl) is purely a checker → stub it outright.
# - debian/scripts/misc/annotations (python) is also used to *generate* the
#   .config during prepare-tree, so we wrap it: --check returns 0, anything
#   else defers to the real script.
printf '#!/usr/bin/perl\nexit 0;\n' > ${KERNEL_DIR}/debian/scripts/config-check
chmod a+x ${KERNEL_DIR}/debian/scripts/config-check

ANN=${KERNEL_DIR}/debian/scripts/misc/annotations
if [ -f "${ANN}" ] && ! [ -f "${ANN}.real" ]; then
    mv "${ANN}" "${ANN}.real"
    cat > "${ANN}" <<'EOF'
#!/usr/bin/env python3
"""
Wrapper around the upstream debian/scripts/misc/annotations.

On --check we (a) skip the strict annotations-vs-.config diff so vendor/ODM
options absent from our build don't fail, and (b) opportunistically disable
kernel subsystems for which this kernel has no upstream CVE fix:
  CONFIG_CRYPTO_USER_API_AEAD  CVE-2026-31431 Copy Fail (algif_aead)
  CONFIG_INET_ESP              CVE-2026-43284 Dirty Frag (esp4)
  CONFIG_INET6_ESP             CVE-2026-43284 Dirty Frag (esp6)
  CONFIG_AF_RXRPC              CVE-2026-43500 Dirty Frag (rxrpc)
Any other invocation defers to the real script (used for .config generation).
"""
import os, re, subprocess, sys

CVE_DISABLE = {
    'CONFIG_CRYPTO_USER_API_AEAD',
    'CONFIG_INET_ESP',
    'CONFIG_INET6_ESP',
    'CONFIG_AF_RXRPC',
}
ARCH_MAP = {'amd64': 'x86', 'i386': 'x86', 'arm64': 'arm64', 'armhf': 'arm'}

def disable(cfg_path, names):
    on_pat  = re.compile(r'^(CONFIG_[A-Z0-9_]+)(=|\s)')
    off_pat = re.compile(r'^# (CONFIG_[A-Z0-9_]+) is not set')
    with open(cfg_path) as f:
        lines = f.readlines()
    seen, out = set(), []
    for line in lines:
        m = on_pat.match(line)
        if m and m.group(1) in names:
            out.append('# %s is not set\n' % m.group(1)); seen.add(m.group(1)); continue
        m = off_pat.match(line)
        if m and m.group(1) in names:
            seen.add(m.group(1))
        out.append(line)
    for n in names - seen:
        out.append('# %s is not set\n' % n)
    with open(cfg_path, 'w') as f:
        f.writelines(out)

argv = sys.argv
if '--check' in argv:
    try:
        cfg = argv[argv.index('--check') + 1]
        arch = argv[argv.index('--arch') + 1] if '--arch' in argv else None
        if cfg and os.path.isfile(cfg):
            disable(cfg, CVE_DISABLE)
            builddir = os.path.dirname(os.path.abspath(cfg))
            srcdir = os.path.abspath(os.path.join(builddir, '..', '..', '..'))
            env = os.environ.copy()
            karch = ARCH_MAP.get(arch)
            if karch:
                env['ARCH'] = karch
            subprocess.run(
                ['make', '-C', srcdir,
                 'O=' + os.path.relpath(builddir, srcdir),
                 'olddefconfig'],
                env=env, check=False,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
    except (IndexError, ValueError, OSError):
        pass
    sys.exit(0)

real = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'annotations.real')
os.execv(real, [real] + sys.argv[1:])
EOF
    chmod a+x "${ANN}"
fi

# kernel
pushd ${KERNEL_DIR}
unset -v ARCH KERNEL_DIR
debian/rules clean
# see https://wiki.ubuntu.com/KernelTeam/KernelMaintenance#Overriding_module_check_failures
# CVE config disables are applied by the annotations --check wrapper above,
# which runs after .config is materialized and before the binary compile.
debian/rules binary-headers binary-generic \
    do_zfs=false \
    do_dkms_nvidia=false \
    do_dkms_nvidia_server=false \
	skipabi=true \
	skipmodule=true \
	skipretpoline=true \
	do_enforce_all=false
popd
