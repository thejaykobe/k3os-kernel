#!/bin/bash
set -e

source $(dirname $0)/version
cd $(dirname $0)/..

KERNEL_DIR=build/kernel

# some hacking
mkdir -p ${KERNEL_DIR}/debian/stamps
chmod a+x ${KERNEL_DIR}/debian*/scripts/*
chmod a+x ${KERNEL_DIR}/debian*/scripts/misc/*

# Annotations may list vendor/ODM CONFIG options (e.g. UBUNTU_ODM_DRIVERS, AAEON_*)
# that aren't reachable in our generic .config. There's no make switch to skip
# this check; replace the perl checker with a no-op to match the spirit of
# skipabi/skipmodule. Leave debian/scripts/misc/annotations alone — it is also
# used to generate the .config, not just check it.
printf '#!/usr/bin/perl\nexit 0;\n' > ${KERNEL_DIR}/debian/scripts/config-check
chmod a+x ${KERNEL_DIR}/debian/scripts/config-check

# kernel
pushd ${KERNEL_DIR}
unset -v ARCH KERNEL_DIR
debian/rules clean
# see https://wiki.ubuntu.com/KernelTeam/KernelMaintenance#Overriding_module_check_failures
debian/rules binary-headers binary-generic \
    do_zfs=false \
    do_dkms_nvidia=false \
    do_dkms_nvidia_server=false \
	skipabi=true \
	skipmodule=true \
	skipretpoline=true \
	do_enforce_all=false
popd
